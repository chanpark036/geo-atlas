# Synthetic mode is offline; mta uses the public feed server-side. Neither needs keys.
TRANSIT_SOURCE=synthetic
HOST=127.0.0.1
PORT=3001
WEB_ORIGIN=http://localhost:5173
# DATABASE_PATH=/absolute/path/to/state.sqlite
# MTA mode records raw feeds by default. Synthetic mode does not create an archive.
ARCHIVE_ENABLED=1
# ARCHIVE_DIRECTORY=/absolute/path/to/history/raw
# ARCHIVE_MAX_BYTES=2147483648
